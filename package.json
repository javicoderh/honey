{
  "name": "honey-react-storefront",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file=.env server/dev.mjs",
    "db:prepare": "node scripts/prepare-database.mjs",
    "db:check": "node --env-file=.env scripts/check-database.mjs",
    "test:api": "node --test scripts/api.test.mjs scripts/http.test.mjs",
    "test:mercadopago": "node --test scripts/mercadopago.test.mjs",
    "test:operation": "node --test scripts/operation.test.mjs",
    "test:marketing": "node --test scripts/marketing.test.mjs",
    "check:marketing-connected": "node --env-file=.env scripts/check-marketing-connected.mjs",
    "check:marketing-browser": "node --env-file=.env scripts/check-marketing-browser.mjs",
    "check:build-modes": "node scripts/check-build-modes.mjs",
    "check:operation": "node scripts/check-operation.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "check:structure": "node scripts/check-structure.mjs",
    "test:domain": "node --test scripts/domain.test.mjs",
    "test:cart": "node --test scripts/cart.test.mjs",
    "test:checkout": "node --test scripts/checkout.test.mjs",
    "test:staff": "node --test scripts/staff.test.mjs",
    "test:orders": "node --test scripts/orders.test.mjs",
    "test:sales": "node --test scripts/sales.test.mjs",
    "test:deliveries": "node --test scripts/deliveries.test.mjs",
    "test:team": "node --test scripts/team.test.mjs",
    "test:review": "node --test scripts/review.test.mjs",
    "test:validation": "node --test scripts/validation.test.mjs",
    "check:review-browser": "node scripts/check-staff-browser.mjs --review",
    "check:api-browser": "node scripts/check-staff-browser.mjs --api",
    "check:mercadopago-browser": "node scripts/check-staff-browser.mjs --api --mercadopago",
    "check:team-browser": "node scripts/check-staff-browser.mjs --team",
    "check:staff-browser": "node scripts/check-staff-browser.mjs",
    "check:orders-browser": "node scripts/check-staff-browser.mjs --orders",
    "check:sales-browser": "node scripts/check-staff-browser.mjs --sales",
    "check:deliveries-browser": "node scripts/check-staff-browser.mjs --deliveries"
  },
  "dependencies": {
    "vite": "8.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {}
