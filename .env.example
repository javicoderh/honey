# Solo "api" activa servicios reales; "demo" mantiene el modo de prueba.
VITE_DATA_MODE=demo
# Dominio canónico público. Al cambiarlo, volver a desplegar y configurar redirecciones.
VITE_SITE_URL=https://honey-d164.vercel.app
# false desactiva indexación; previews y modo demo siempre quedan fuera.
VITE_SEO_INDEXING=true
# Opcional: endpoint público del catálogo usado al compilar en modo api.
# SEO_CATALOG_SOURCE=https://honey-d164.vercel.app/api?route=catalog
# Variables privadas: NUNCA deben llevar prefijo VITE_.
APP_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_SECRET_KEY=
ORDER_ACCESS_SECRET=
# Tarifa inicial acordada en CLP. Sin comunas configuradas se bloquean compras.
SHIPPING_FEE_CLP=3000
SHIPPING_COMMUNES=
